# CapacityOS API configuration (copy to .env; .env is gitignored). No key is needed: the deterministic stub provider is the default.
# Owner/operator agent provider: stub (default, deterministic, offline) | openai
OWNER_AGENT_PROVIDER=stub
# Only for OWNER_AGENT_PROVIDER=openai (also: pip install -e "apps/api[openai]"). Never commit a real key.
OPENAI_API_KEY=
OWNER_AGENT_MODEL=gpt-4o-mini
OWNER_AGENT_TIMEOUT_SECONDS=20
OWNER_AGENT_MAX_RETRIES=1
# Minimum seconds between model calls (0 = none). Free/low tiers allow ~10 requests/min: use 6.5. A run then takes ~2-3 min.
OWNER_AGENT_MIN_INTERVAL_SECONDS=0
